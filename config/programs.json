{
  "version": 1,
  "_comment": "Non-secret program config. Secrets live in .env, matched by passwordEnv. To add a sixth program: add one entry here and drop one adapter file in src/adapters/.",
  "programs": [
    {
      "key": "american_peptides",
      "displayName": "American Peptides",
      "storeUrl": "https://americanpeptides.us",
      "dashboardUrl": "https://partners.americanpeptides.us/dashboard",
      "loginUrl": null,
      "commissionRate": 0.10,
      "cookieWindowDays": 30,
      "currency": "USD",
      "adapter": "manual",
      "passwordEnv": "AMERICAN_PEPTIDES_PASSWORD",
      "loginIdentity": "email",
      "platform": { "suspected": "goaffpro-or-uppromote", "confirmed": null },
      "tracking": { "type": "referral_link", "param": null },
      "expectedMetrics": { "clicks": true, "conversions": true, "earnings": true, "unpaidEarnings": true, "paidEarnings": true },
      "notes": "Dedicated partners. subdomain. Platform unconfirmed until discovery run."
    },
    {
      "key": "ameano_peptides",
      "displayName": "Ameano Peptides",
      "storeUrl": "https://ameanopeptides.com",
      "dashboardUrl": "https://partners.ameanopeptides.com/",
      "loginUrl": null,
      "commissionRate": 0.10,
      "cookieWindowDays": null,
      "currency": "USD",
      "adapter": "manual",
      "passwordEnv": "AMEANO_PEPTIDES_PASSWORD",
      "loginIdentity": "email",
      "platform": { "suspected": "goaffpro-or-uppromote", "confirmed": null },
      "tracking": { "type": "referral_link", "param": "ref" },
      "expectedMetrics": { "clicks": true, "conversions": true, "earnings": true, "unpaidEarnings": true, "paidEarnings": true },
      "notes": "Dedicated partners. subdomain, ?ref= param. Cookie window unknown — confirm in the affiliate terms."
    },
    {
      "key": "idun_peptides",
      "displayName": "IDUN Peptides",
      "storeUrl": "https://idunpeptides.com",
      "dashboardUrl": "https://idunpeptides.com/affiliate-area/",
      "loginUrl": "https://idunpeptides.com/affiliate-area/",
      "commissionRate": 0.20,
      "cookieWindowDays": 90,
      "currency": "USD",
      "adapter": "manual",
      "candidateAdapter": "affiliatewp",
      "passwordEnv": "IDUN_PEPTIDES_PASSWORD",
      "loginIdentity": "username",
      "platform": { "suspected": "affiliatewp", "confirmed": null },
      "tracking": { "type": "referral_link", "param": "ref", "affiliateIdIsEmail": true },
      "expectedMetrics": { "clicks": true, "conversions": true, "earnings": true, "unpaidEarnings": true, "paidEarnings": true },
      "notes": "AffiliateWP on WooCommerce (/affiliate-area/ is its default path). Referral link uses the email address as affiliate ID, so it arrives URL-encoded (%40) — decode before comparing."
    },
    {
      "key": "synthesis_peptides",
      "displayName": "Synthesis Peptides",
      "storeUrl": "https://synthesispeptides.co",
      "dashboardUrl": "https://synthesispeptides.co/account",
