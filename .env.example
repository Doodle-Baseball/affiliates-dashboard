# Copy to .env and fill in. .env is gitignored — never commit it.
#
# THIS FILE IS TRACKED IN GIT AND THE REPOSITORY IS PUBLIC.
# It is a template. Every value below must stay empty here.
# Put real values in .env, which git ignores. If you ever paste a real
# password into this file, treat that password as compromised and change it
# at the provider — deleting it from the file is not enough, because git
# keeps the old version.

# --- shared identity (same across all five programs) ---
AFFILIATE_EMAIL=
AFFILIATE_USERNAME=

# --- per-program passwords (key matches passwordEnv in config/programs.json) ---
AMERICAN_PEPTIDES_PASSWORD=
AMEANO_PEPTIDES_PASSWORD=
IDUN_PEPTIDES_PASSWORD=
SYNTHESIS_PEPTIDES_PASSWORD=
BLUE_RIDGE_PEPTIDES_PASSWORD=

# --- local options ---
# Port for the local dashboard (binds to 127.0.0.1 only).
PORT=4317
# IANA timezone deciding which calendar day a snapshot belongs to. Blank = this machine's.
TIMEZONE=
# How many programs to sync at once. Keep this low; these are small stores.
SYNC_CONCURRENCY=2
# Set to 1 to watch the browser drive itself while debugging an adapter.
HEADED=0

# --- database ---
# Blank uses the local SQLite file at data/affiliates.sqlite.
# For a deployed dashboard, point BOTH this machine and the deployment at the
# same hosted libSQL database (Turso) so they share history:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- deployment (see DEPLOY.md) ---
# Required on any deployed instance. The dashboard shows your earnings and its
# sync endpoints can drive sign-ins to your affiliate accounts, so it refuses to
# serve without this. Not needed locally.
DASHBOARD_PASSWORD=
# Write-only token used by `npm run sync -- --push` to post snapshots up.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_TOKEN=
# Where `npm run sync -- --push` sends results, e.g. https://your-app.vercel.app
DASHBOARD_URL=
