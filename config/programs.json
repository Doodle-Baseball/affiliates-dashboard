      "tracking": { "type": "referral_link", "param": "synthaff" },
      "expectedMetrics": { "clicks": true, "conversions": true, "earnings": true, "unpaidEarnings": true, "paidEarnings": true },
      "notes": "Custom build, tracking param ?synthaff=. Stats may live behind a tab on /account rather than a dedicated page."
